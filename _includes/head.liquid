<!-- Metadata, OpenGraph and Schema.org -->
{% include metadata.liquid %}

<!-- Security: Content Security Policy -->
<!-- Permissive CSP suitable for academic websites. Allows external images, videos, and common embed services. -->
<!-- To customize for your needs, see: https://developer.mozilla.org/en-US/docs/Web/HTTP/CSP -->
<meta
  http-equiv="Content-Security-Policy"
  content="default-src 'self'; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: https:; font-src 'self' data: https:; media-src 'self' https:; frame-src 'self' https:; connect-src 'self' https:;"
>
<style>
  :root {
    --max-content-width: {{ site.max_width | default: '960px' }};

    /* Custom theme overrides */
    --global-theme-color: #3d7ab5;
    --global-hover-color: #3d7ab5;
    --global-hover-text-color: #ffffff;
    --global-highlight-color: #2d5f8a;

    /* Slightly softer black for body text */
    --global-text-color: #1a1a2e;
  }

  html[data-theme="dark"] {
    --global-theme-color: #6aabde;
    --global-hover-color: #6aabde;
    --global-highlight-color: #4a8fcc;
  }

  /* Typography */
  body {
    font-family: 'Inter', 'Roboto', sans-serif;
    letter-spacing: -0.01em;
    line-height: 1.7;
  }

  /* Navbar: cleaner, slightly lighter weight */
  .navbar {
    border-bottom: 1px solid rgba(0,0,0,0.07);
    box-shadow: none !important;
  }

  .navbar-brand {
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .nav-item .nav-link {
    font-weight: 400;
    font-size: 0.92rem;
    letter-spacing: 0.01em;
  }

  /* Profile image: shadow only (circular vs square set by image_circular in about.md) */
  .profile img {
    box-shadow: 0 4px 20px rgba(0,0,0,0.12);
  }

  /* About page: softer heading */
  h1.post-title {
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  /* Cards: lighter border, more breathing room */
  .card {
    border: 1px solid rgba(0,0,0,0.08) !important;
    border-radius: 10px !important;
    box-shadow: 0 1px 6px rgba(0,0,0,0.05) !important;
  }

  /* CV section badges: use theme color */
  .badge.danger-color-dark {
    background-color: var(--global-theme-color) !important;
    font-weight: 500;
    font-size: 0.7rem;
  }

  /* News items: cleaner separator */
  .news table td {
    border-top: 1px solid rgba(0,0,0,0.06);
  }

  /* Footer: slightly lighter */
  .footer {
    font-size: 0.82rem;
  }

  /* Links: no underline by default, color on hover */
  a {
    text-decoration: none;
    color: var(--global-theme-color);
  }
  a:hover {
    text-decoration: underline;
    color: var(--global-hover-color);
  }

  /* Ensure inline elements inside links inherit the link color */
  a em, a strong, a code {
    color: inherit;
  }

  /* News section: underline links so they are visible as plain text */
  .news td a {
    text-decoration: underline;
  }

  /* Social icons: slightly larger spacing */
  .contact-icons a {
    margin: 0 6px;
    font-size: 1.4rem;
  }

  /* CV: remove bullets from list-group entries */
  .cv ul.list-group,
  .cv ul.list-group-flush {
    padding-left: 0;
    list-style: none;
  }
  .cv ul.list-group .list-group-item,
  .cv ul.list-group-flush .list-group-item {
    list-style: none;
    padding: 1rem 0.25rem;
    border-top: 1px solid rgba(0,0,0,0.07);
  }
  .cv ul.list-group .list-group-item:first-child {
    border-top: none;
  }

  /* CV: right-align date column, minimal padding to sit close to content */
  .cv .date-column {
    padding-right: 4px;
    text-align: right !important;
  }
  .cv .date-column .badge {
    font-size: 0.72rem;
    white-space: nowrap !important;
  }

  /* CV mobile: on xs screens columns stack full-width, so switch to left-aligned layout */
  @media (max-width: 575px) {
    .cv .date-column {
      text-align: left !important;
      padding-right: 15px !important;
    }
    .cv .date-column .badge {
      white-space: normal !important;
    }
    .cv .date-column p.location {
      text-align: left !important;
    }
  }

  /* Publications: subsection heading colour, adapts to dark mode */
  .publications h2.bibliography {
    color: #2c2c2c !important;
  }
  html[data-theme="dark"] .publications h2.bibliography {
    color: #aaaaaa !important;
  }

  /* CV education: score/grade text adapts to dark mode */
  .cv-score {
    font-size: 0.85rem;
    color: #666;
    margin-top: 0.25rem;
  }
  html[data-theme="dark"] .cv-score {
    color: #999999 !important;
  }
</style>

<!-- Tailwind-first core styles -->
<link rel="stylesheet" href="{{ '/assets/css/tailwind.css' | relative_url | bust_file_cache }}">

{% if site.al_folio.compat.bootstrap.enabled %}
  <!-- Optional Bootstrap compatibility layer -->
  <link rel="stylesheet" href="{{ '/assets/css/bootstrap-compat.css' | relative_url | bust_file_cache }}">
{% endif %}

{% if page.pretty_table and site.al_folio.compat.bootstrap.enabled %}
  <!-- Bootstrap Table -->
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.bootstrap-table.url.css }}"
    integrity="{{ site.third_party_libraries.bootstrap-table.integrity.css }}"
    crossorigin="anonymous"
  >
{% endif %}

{% if page.toc and page.toc.sidebar %}
  <!-- Tocbot -->
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.tocbot.url.css }}"
    integrity="{{ site.third_party_libraries.tocbot.integrity.css }}"
    crossorigin="anonymous"
  >
{% endif %}

<!-- Icons -->
{% if site.plugins contains 'al_icons' %}
  {% include plugins/al_icons_styles.liquid %}
{% endif %}
<link
  defer
  rel="stylesheet"
  type="text/css"
  href="{{ site.third_party_libraries.google_fonts.url.fonts }}"
>

<!-- Code Syntax Highlighting -->
<link
  defer
  rel="stylesheet"
  href="{{ '/assets/css/jekyll-pygments-themes-github.css' | relative_url | bust_file_cache }}"
  media=""
  id="highlight_theme_light"
>

<!-- Styles -->

{% if page.pseudocode %}
  <!-- pseudocode -->
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.pseudocode.url.css }}"
    integrity="{{ site.third_party_libraries.pseudocode.integrity.css }}"
    crossorigin="anonymous"
  >
{% endif %}

{% if site.icon.size <= 4 %}
  <link
    rel="shortcut icon"
    href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>{{ site.icon }}</text></svg>"
  >
{% elsif site.icon != blank %}
  <link rel="shortcut icon" href="{{ site.icon | prepend: '/assets/img/' | relative_url | bust_file_cache}}">
{% endif %}
<link rel="stylesheet" href="{{ '/assets/css/main.css' | relative_url | bust_css_cache }}">
{% if page.layout == 'about' %}
  <!-- About-page subtitle: distinct treatment so it reads as a title-block subtitle, not body copy -->
  <style>
    .post-header:has(.desc) {
      padding-bottom: 1.1rem;
      margin-bottom: 1.6rem;
      border-bottom: 1px solid var(--global-divider-color);
    }
    .post-header .desc {
      margin-top: 0.7rem;
      margin-bottom: 0;
      font-size: 1.15rem;
      line-height: 1.5;
      font-weight: 400;
      color: var(--global-text-color-light);
    }
    .post-header .desc .subtitle-line {
      display: block;
    }
    .post-header .desc .subtitle-line + .subtitle-line {
      margin-top: 0.25rem;
    }
    .post-header .desc .subtitle-role {
      color: var(--global-text-color);
      font-weight: 600;
    }
    .post-header .desc .subtitle-affil {
      color: var(--global-theme-color);
      font-weight: 500;
    }
    .post-header .desc .subtitle-at,
    .post-header .desc .subtitle-sep {
      color: var(--global-text-color-light);
      margin: 0 0.15em;
    }
    .post-header .desc a {
      color: inherit;
      text-decoration: none;
      border-bottom: 1px solid transparent;
      transition: border-color 0.15s ease;
    }
    .post-header .desc a:hover {
      border-bottom-color: currentColor;
    }
    @media (max-width: 576px) {
      .post-header .desc {
        font-size: 1.05rem;
      }
    }
  </style>
{% endif %}
{% if page.layout == 'cv' and site.plugins contains 'al_folio_cv' and site.al_folio.features.cv.enabled != false %}
  <link rel="stylesheet" href="{{ '/assets/css/al-folio-cv.css' | relative_url | bust_file_cache }}">
{% endif %}
<link rel="canonical" href="{{ page.url | replace:'index.html','' | absolute_url }}">

{% if site.enable_darkmode %}
  <!-- Dark Mode -->
  <script src="{{ '/assets/js/theme.js' | relative_url | bust_file_cache }}"></script>
  <link
    defer
    rel="stylesheet"
    href="{{ '/assets/css/jekyll-pygments-themes-native.css' | relative_url | bust_file_cache }}"
    media="none"
    id="highlight_theme_dark"
  >
  <script>
    initTheme();
  </script>
{% endif %}

{% if page.map %}
  <!-- GeoJSON support via Leaflet -->
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.leaflet.url.css }}"
    integrity="{{ site.third_party_libraries.leaflet.integrity.css }}"
    crossorigin="anonymous"
  >
{% endif %}

{% if page.code_diff %}
  <!-- diff2html -->
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.highlightjs.url.css.light }}"
    integrity="{{ site.third_party_libraries.highlightjs.integrity.css.light }}"
    crossorigin="anonymous"
    media="screen and (prefers-color-scheme: light)"
  >
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.highlightjs.url.css.dark }}"
    integrity="{{ site.third_party_libraries.highlightjs.integrity.css.dark }}"
    crossorigin="anonymous"
    media="screen and (prefers-color-scheme: dark)"
  >
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.diff2html.url.css }}"
    integrity="{{ site.third_party_libraries.diff2html.integrity.css }}"
    crossorigin="anonymous"
  >
{% endif %}

{% if site.plugins contains 'al_img_tools' %}
  <!-- Image Features -->
  {% include plugins/al_img_tools_styles.liquid %}
{% endif %}

{% if site.plugins contains 'al_math' %}
  {% include plugins/al_math_styles.liquid %}
{% endif %}

{% if site.enable_cookie_consent and site.plugins contains 'al_cookie' %}
  <!-- Cookie Consent -->
  {% include plugins/al_cookie_styles.liquid %}
{% endif %}
