{% if page.layout == 'about' %}
  <!-- About-page subtitle: distinct treatment so it reads as a title-block subtitle, not body copy -->
  <style>
    .post-header:has(.desc) {
      padding-bottom: 1.1rem;
      margin-bottom: 1.6rem;
      border-bottom: 1px solid var(--global-divider-color);
    }
    .post-header .desc {
      margin-top: 0.7rem;
      margin-bottom: 0;
      font-size: 1.15rem;
      line-height: 1.5;
      font-weight: 400;
      color: var(--global-text-color-light);
    }
    .post-header .desc .subtitle-line {
      display: block;
    }
    .post-header .desc .subtitle-line + .subtitle-line {
      margin-top: 0.25rem;
    }
    .post-header .desc .subtitle-role {
      color: var(--global-text-color);
      font-weight: 600;
    }
    .post-header .desc .subtitle-affil {
      color: var(--global-theme-color);
      font-weight: 500;
    }
    .post-header .desc .subtitle-at,
    .post-header .desc .subtitle-sep {
      color: var(--global-text-color-light);
      margin: 0 0.15em;
    }
    .post-header .desc a {
      color: inherit;
      text-decoration: none;
      border-bottom: 1px solid transparent;
      transition: border-color 0.15s ease;
    }
    .post-header .desc a:hover {
      border-bottom-color: currentColor;
    }
    @media (max-width: 576px) {
      .post-header .desc {
        font-size: 1.05rem;
      }
    }
  </style>
{% endif %}
{% if page.layout == 'cv' and site.plugins contains 'al_folio_cv' and site.al_folio.features.cv.enabled != false %}
  <link rel="stylesheet" href="{{ '/assets/css/al-folio-cv.css' | relative_url | bust_file_cache }}">
  <!-- CV entries: keep the date range on one line with room to breathe; stack cleanly on mobile.
       The theme's col-xs-* grid classes are Bootstrap 3 syntax and don't lay out here, so the
       date column collapsed to the badge's min-width and clipped the range. Lay it out with flex. -->
  <style>
    .cv .list-group-item > .row {
      display: flex;
      flex-wrap: nowrap;
      align-items: flex-start;
      gap: 0.85rem;
      margin-left: 0;
      margin-right: 0;
    }
    /* Fixed-width date column so the right column starts at the same x on
       every entry, regardless of how wide that row's badge or location is. */
    .cv .date-column {
      flex: 0 0 150px;
      width: 150px;
      max-width: 150px;
      padding-left: 0;
      padding-right: 0;
    }
    .cv .date-column .badge {
      min-width: 0 !important;
      width: auto;
      white-space: nowrap !important;
      font-size: 0.72rem;
      line-height: 1.3;
      padding: 0.4em 0.65em;
    }
    .cv .date-column .location {
      text-align: right;
      margin-top: 0.4rem;
      white-space: normal;
    }
    .cv .list-group-item > .row > div:last-child {
      flex: 1 1 auto;
      min-width: 0;
      padding-left: 0;
    }
    @media (max-width: 575.98px) {
      .cv .list-group-item > .row {
        flex-wrap: wrap;
      }
      .cv .date-column {
        flex: 0 0 100%;
        width: 100%;
        max-width: 100%;
        margin-bottom: 0.5rem;
      }
      .cv .date-column .location {
        text-align: left;
        margin-top: 0.3rem;
      }
    }
  </style>
{% endif %}
