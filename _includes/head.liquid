<!-- Security: Content Security Policy -->
<!-- Permissive CSP suitable for academic websites. Allows external images, videos, and common embed services. -->
<!-- To customize for your needs, see: https://developer.mozilla.org/en-US/docs/Web/HTTP/CSP -->
<meta
  http-equiv="Content-Security-Policy"
  content="default-src 'self'; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: https:; font-src 'self' data: https:; media-src 'self' https:; frame-src 'self' https:; connect-src 'self' https:;"
>
<style>
  :root {
    --max-content-width: {{ site.max_width | default: '960px' }};

    /* Custom theme overrides */
    --global-theme-color: #3d7ab5;
    --global-hover-color: #3d7ab5;
    --global-hover-text-color: #ffffff;
    --global-highlight-color: #2d5f8a;

    /* Slightly softer black for body text */
    --global-text-color: #1a1a2e;
  }

  html[data-theme="dark"] {
    --global-theme-color: #6aabde;
    --global-hover-color: #6aabde;
    --global-highlight-color: #4a8fcc;
  }

  /* Typography */
  body {
    font-family: 'Inter', 'Roboto', sans-serif;
    letter-spacing: -0.01em;
    line-height: 1.7;
  }

  /* Navbar: cleaner, slightly lighter weight */
  .navbar {
    border-bottom: 1px solid rgba(0,0,0,0.07);
    box-shadow: none !important;
  }

  .navbar-brand {
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .nav-item .nav-link {
    font-weight: 400;
    font-size: 0.92rem;
    letter-spacing: 0.01em;
  }

  /* Profile image: shadow only (circular vs square set by image_circular in about.md) */
  .profile img {
    box-shadow: 0 4px 20px rgba(0,0,0,0.12);
  }

  /* About page: softer heading */
  h1.post-title {
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  /* Cards: lighter border, more breathing room */
  .card {
    border: 1px solid rgba(0,0,0,0.08) !important;
    border-radius: 10px !important;
    box-shadow: 0 1px 6px rgba(0,0,0,0.05) !important;
  }

  /* CV section badges: use theme color */
  .badge.danger-color-dark {
    background-color: var(--global-theme-color) !important;
    font-weight: 500;
    font-size: 0.7rem;
  }

  /* News items: cleaner separator */
  .news table td {
    border-top: 1px solid rgba(0,0,0,0.06);
  }

  /* Footer: slightly lighter */
  .footer {
    font-size: 0.82rem;
  }

  /* Links: no underline by default, color on hover */
  a {
    text-decoration: none;
    color: var(--global-theme-color);
  }
  a:hover {
    text-decoration: underline;
    color: var(--global-hover-color);
  }

  /* Ensure inline elements inside links inherit the link color */
  a em, a strong, a code {
    color: inherit;
  }

  /* News section: underline links so they are visible as plain text */
  .news td a {
    text-decoration: underline;
  }

  /* Social icons: slightly larger spacing */
  .contact-icons a {
    margin: 0 6px;
    font-size: 1.4rem;
  }

  /* CV: remove bullets from list-group entries */
  .cv ul.list-group,
  .cv ul.list-group-flush {
    padding-left: 0;
    list-style: none;
  }
  .cv ul.list-group .list-group-item,
  .cv ul.list-group-flush .list-group-item {
    list-style: none;
    padding: 1rem 0.25rem;
    border-top: 1px solid rgba(0,0,0,0.07);
  }
  .cv ul.list-group .list-group-item:first-child {
    border-top: none;
  }

  /* CV: right-align date column, minimal padding to sit close to content */
  .cv .date-column {
    padding-right: 4px;
    text-align: right !important;
  }
  .cv .date-column .badge {
    font-size: 0.72rem;
    white-space: nowrap !important;
  }

  /* CV mobile: on xs screens columns stack full-width, so switch to left-aligned layout */
  @media (max-width: 575px) {
    .cv .date-column {
      text-align: left !important;
      padding-right: 15px !important;
    }
    .cv .date-column .badge {
      white-space: normal !important;
    }
    .cv .date-column p.location {
      text-align: left !important;
    }
  }

  /* Home page news: a fixed-height box showing the ~3 most recent items, with
     older ones reached by scrolling inside it. Scoped by the inline max-height
     that the theme emits only for the scrollable (home page) instance, so the
     full /news/ archive is left at its natural length. The !important is needed
     to beat that inline style, whose 60vw never actually constrains on desktop. */
  /* Fallback height for ~3 rows; the script below measures the real rows and
     replaces this with an exact value, since row heights vary with wrapping. */
  .news .table-responsive[style*="max-height"] {
    max-height: 13.5rem !important;
    overflow-y: auto;
    border: 1px solid var(--global-divider-color);
    border-radius: 8px;
    padding: 0 0.9rem;
    /* The table's own 1rem bottom margin is zeroed below to keep the box's
       inside edge tight, so carry that spacing on the box instead; otherwise
       the next section's heading sits flush against the border. */
    margin-bottom: 1rem;
  }
  .news .table-responsive[style*="max-height"] .table {
    margin-bottom: 0;
  }
  /* No rule above the first row: the box's own border is the top edge. */
  .news .table-responsive[style*="max-height"] tr:first-child th,
  .news .table-responsive[style*="max-height"] tr:first-child td {
    border-top: 0;
  }

  /* Publications: subsection heading colour, adapts to dark mode */
  .publications h2.bibliography {
    color: #2c2c2c !important;
  }
  html[data-theme="dark"] .publications h2.bibliography {
    color: #aaaaaa !important;
  }

  /* CV education: score/grade text adapts to dark mode */
  .cv-score {
    font-size: 0.85rem;
    color: #666;
    margin-top: 0.25rem;
  }
  html[data-theme="dark"] .cv-score {
    color: #999999 !important;
  }
</style>

<script>
  // Size the home page news box to exactly its three most recent items, leaving
  // the rest reachable by scrolling. Row heights depend on how each item wraps,
  // so they are measured rather than assumed; the CSS above carries a static
  // fallback for the no-JS case.
  (function () {
    var VISIBLE = 3;

    function fit() {
      var box = document.querySelector('.news .table-responsive[style*="max-height"]');
      if (!box) return;
      var rows = box.querySelectorAll('tr');
      if (rows.length <= VISIBLE) {
        // Nothing is hidden, so let the box take its natural height.
        box.style.setProperty('max-height', 'none', 'important');
        return;
      }
      var h = 0;
      for (var i = 0; i < VISIBLE; i++) {
        h += rows[i].getBoundingClientRect().height;
      }
      // box-sizing is border-box here, so max-height covers the borders too;
      // add that chrome or the third row is clipped by a couple of pixels.
      h += box.offsetHeight - box.clientHeight;
      // Inline !important, to beat both the theme's inline max-height and the
      // !important fallback rule.
      box.style.setProperty('max-height', Math.ceil(h) + 'px', 'important');
    }

    var pending;
    function refit() {
      clearTimeout(pending);
      pending = setTimeout(fit, 120);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', fit);
    } else {
      fit();
    }
    // Re-measure once webfonts have settled and whenever wrapping can change.
    window.addEventListener('load', fit);
    window.addEventListener('resize', refit);
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(fit).catch(function () {});
    }
  })();
</script>

