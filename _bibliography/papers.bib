@inproceedings{stroecker2026ames,
  abbr        = {CCN},
  title       = {Measuring Depth Inversion in the {Ames} Window Illusion},
  author      = {Stroecker, Emil and Cheng, Fan and Kriegeskorte, Nikolaus},
  booktitle   = {9th Annual Conference on Cognitive Computational Neuroscience},
  year        = {2026},
  month       = {August},
  address     = {New York City, USA},
  note        = {Extended abstract, accepted},
  selected    = {true},
  bibtex_show = {true},
  abstract    = {The Ames Window Illusion is a classic demonstration of how the visual system imposes a strong prior
    for rectangular shapes, causing a trapezoidal window silhouette to be perceived as a full rectangle oscillating
    back and forth rather than rotating continuously. We investigate whether contemporary depth estimation neural
    networks -- trained on large-scale real-world image datasets -- exhibit analogous geometric biases when processing
    the Ames Window stimulus. We present psychophysical measurements of depth inversion responses in human observers
    and compare these to the outputs of three state-of-the-art monocular depth networks (Metric3D, DSINE, MoGe).
    Our results characterise the extent to which these models replicate human-like geometric priors in depth
    perception, with implications for using such networks as models of the ventral visual stream.}
}
